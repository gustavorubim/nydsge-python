# Copy this file to .env for local runs that need FRED/ALFRED API access.
# The Python CLI reads .env automatically when --api-key and FRED_API_KEY
# are not set.

# Required for:
#   uv run nydsge data fetch-fred-api ...
#   real-time vintage / ALFRED parity fixture generation
FRED_API_KEY=replace_with_your_fred_api_key
